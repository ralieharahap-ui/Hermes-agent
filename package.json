{
  "name": "hermes-agent",
  "version": "0.1.0",
  "description": "Hermes Desktop Agent - AI assistant with device access capabilities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
